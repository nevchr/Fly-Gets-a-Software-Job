# Lower values make each simulation step happen faster.
SIMULATION_TICK_SECONDS=4.5
SIMULATION_SPEED=1.0
SIMULATION_SEED=314159
DATABASE_URL=sqlite:///./data/fly_career.db
MAX_STORED_EVENTS=1000
BRAIN_BACKEND=connectome
FLY_BRAIN_DEVICE=auto
FLY_BRAIN_DECISION_MS=250
# Leave blank for the flybrain default: ~/fly-data
FLY_BRAIN_DATA_DIR=
